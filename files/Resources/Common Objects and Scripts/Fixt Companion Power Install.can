CCannedObject
{
	Object=CIfExpressionAction
	{
		If Expression=CIsEqualTo
		{
			Operand1=CVariableDerivedCharacterAttribute
			{
				Character Attribute=Derived Character Attributes/Game Scripting Variables/Fixt Companion Power Watch
			}
			Operator=
			Operand2=CConstant
			{
				Constant Value=0
			}
		}
		Character to get attributes from=Player1
		Then=CMultipleActionsAction
		{
			Action=Array
			{
				Item Count=2
				Action=CAddAIAction
				{
					Target Name=Player1
					AI=CXRPGAITriggerWhenLevelUp
					{
						Marked For Deletion=0
						Publisher=
						Action=CUseCannedActionAction
						{
							Canned Object=Common Objects and Scripts/Fixt Companion Power Growth
						}
						Last Level=0
						Last Level Initialized=0
					}
					Delay Between Adds=0
				}
				Action=CAddCharacterModifierToCharacterAction
				{
					Modifier Description=
					Modification is permanent=0
					Character to modify=Player1
					Modifiers=Array
					{
						Item Count=1
						Modifier=CCharacterModifierDerivedAttribute
						{
							Modification Amount=CConstant
							{
								Constant Value=1
							}
							Modification amount is a percent=0
							Allow Accumulation=1
							Derived character attribute to modify=Derived Character Attributes/Game Scripting Variables/Fixt Companion Power Watch
						}
					}
					OPTIONAL Duration=
					Expression Context=$Instigator
				}
			}
		}
		Else=
	}
}
