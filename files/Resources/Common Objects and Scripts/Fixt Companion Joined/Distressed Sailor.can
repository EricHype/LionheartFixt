CCannedObject
{
	Object=CMultipleActionsAction
	{
		Action=Array
		{
			Item Count=4
			Action=CIfExpressionAction
			{
				If Expression=CIsEqualTo
				{
					Operand1=CVariableDerivedCharacterAttribute
					{
						Character Attribute=Derived Character Attributes/Game Scripting Variables/Fixt Companion Distressed Sailor
					}
					Operator=
					Operand2=CConstant
					{
						Constant Value=0
					}
				}
				Character to get attributes from=Player1
				Then=CAddCharacterModifierToCharacterAction
				{
					Modifier Description=
					Modification is permanent=0
					Character to modify=Player1
					Modifiers=Array
					{
						Item Count=1
						Modifier=CCharacterModifierDerivedAttribute
						{
							Modification Amount=CConstant
							{
								Constant Value=1
							}
							Modification amount is a percent=0
							Allow Accumulation=1
							Derived character attribute to modify=Derived Character Attributes/Game Scripting Variables/Fixt Companion Distressed Sailor
						}
					}
					OPTIONAL Duration=
					Expression Context=$Instigator
				}
				Else=
			}
			Action=CUseCannedActionAction
			{
				Canned Object=Common Objects and Scripts/Fixt Companion Growth Install
			}
			Action=CUseCannedActionAction
			{
				Canned Object=Common Objects and Scripts/Fixt Companion Health Install
			}
			Action=CIfExpressionAction
			{
				If Expression=CIsEqualTo
				{
					Operand1=CVariableDerivedCharacterAttribute
					{
						Character Attribute=Derived Character Attributes/Game Scripting Variables/Fixt Fernand Stride
					}
					Operator=
					Operand2=CConstant
					{
						Constant Value=0
					}
				}
				Character to get attributes from=Player1
				Then=CIfAction
				{
					If=CCheckExistenceAction
					{
						Name To Check For=Distressed Sailor
						Desired Minimum Count=1
					}
					Then=CMultipleActionsAction
					{
						Action=Array
						{
							Item Count=2
							Action=CAddCharacterModifierToCharacterAction
							{
								Modifier Description=Fixt Fernand stride
								Modification is permanent=1
								Character to modify=Distressed Sailor
								Modifiers=Array
								{
									Item Count=1
									Modifier=CCharacterModifierDerivedAttribute
									{
										Modification Amount=CConstant
										{
											Constant Value=0.2
										}
										Modification amount is a percent=0
										Allow Accumulation=1
										Derived character attribute to modify=Derived Character Attributes/Speed/Walk Magic Speed Multiplier
									}
								}
								OPTIONAL Duration=
								Expression Context=$Instigator
							}
							Action=CAddCharacterModifierToCharacterAction
							{
								Modifier Description=
								Modification is permanent=0
								Character to modify=Player1
								Modifiers=Array
								{
									Item Count=1
									Modifier=CCharacterModifierDerivedAttribute
									{
										Modification Amount=CConstant
										{
											Constant Value=1
										}
										Modification amount is a percent=0
										Allow Accumulation=1
										Derived character attribute to modify=Derived Character Attributes/Game Scripting Variables/Fixt Fernand Stride
									}
								}
								OPTIONAL Duration=
								Expression Context=$Instigator
							}
						}
					}
					Else=
					Return failure if the If failes=0
				}
				Else=
			}
		}
	}
}
