CCannedObject
{
	Object=CIfExpressionAction
	{
		If Expression=CIsEqualTo
		{
			Operand1=CVariableDerivedCharacterAttribute
			{
				Character Attribute=Derived Character Attributes/Game Scripting Variables/Fixt Companion Grace
			}
			Operator=
			Operand2=CConstant
			{
				Constant Value=0
			}
		}
		Character to get attributes from=Player1
		Then=CAddCharacterModifierToCharacterAction
		{
			Modifier Description=
			Modification is permanent=0
			Character to modify=Player1
			Modifiers=Array
			{
				Item Count=1
				Modifier=CCharacterModifierDerivedAttribute
				{
					Modification Amount=CConstant
					{
						Constant Value=2
					}
					Modification amount is a percent=0
					Allow Accumulation=1
					Derived character attribute to modify=Derived Character Attributes/Game Scripting Variables/Fixt Companion Grace
				}
			}
			OPTIONAL Duration=
			Expression Context=Player1
		}
		Else=CIfExpressionAction
		{
			If Expression=CIsEqualTo
			{
				Operand1=CVariableDerivedCharacterAttribute
				{
					Character Attribute=Derived Character Attributes/Game Scripting Variables/Fixt Companion Grace
				}
				Operator=
				Operand2=CConstant
				{
					Constant Value=1
				}
			}
			Character to get attributes from=Player1
			Then=CAddCharacterModifierToCharacterAction
			{
				Modifier Description=
				Modification is permanent=0
				Character to modify=Player1
				Modifiers=Array
				{
					Item Count=1
					Modifier=CCharacterModifierDerivedAttribute
					{
						Modification Amount=CConstant
						{
							Constant Value=2
						}
						Modification amount is a percent=0
						Allow Accumulation=1
						Derived character attribute to modify=Derived Character Attributes/Game Scripting Variables/Fixt Companion Grace
					}
				}
				OPTIONAL Duration=
				Expression Context=Player1
			}
			Else=
		}
	}
}
