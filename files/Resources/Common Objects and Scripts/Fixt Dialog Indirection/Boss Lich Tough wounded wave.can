								Source Name=ghoul clone generator
								New Name=used ghoul clone generator
								Set Facing Angle=0
								New Facing Angle=0
							}
							Delay=1.5
							Plus or Minus=0
							Forget Trigger=0
						}
						Action=CSpawnEffectAction
						{
							Explosion Model=Spell Effects/Hits and Effects/Summoning/Monster Summoning
							Location Entity=
							Make effect a child of the location entity=0
							X Offset=0
