							Height Offset=0
							Play Default Sound=1
							Action to execute After Effect=
						}
						Action=CDelayAction
						{
							Next Action=CDeleteAction
							{
								Target Name=used ghoul clone generator
							}
							Delay=2
							Plus or Minus=0
							Forget Trigger=0
						}
					}
				}
			}
			When Done=Do Nothing
			Require Success To Advance=1
			Next Action Index=0
		}
		Else=
		Return failure if the If failes=0
	}
