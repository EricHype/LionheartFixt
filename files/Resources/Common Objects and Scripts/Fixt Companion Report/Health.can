								Else=CIfExpressionAction
								{
									If Expression=CIsLessThan
									{
										Operand1=CVariableDerivedCharacterAttribute
										{
											Character Attribute=Derived Character Attributes/(HP) Hit Points
										}
										Operator=
										Operand2=CConstant
										{
											Constant Value=499
										}
									}
									Character to get attributes from=$Trigger
									Then=CIfExpressionAction
									{
										If Expression=CIsLessThan
										{
											Operand1=CVariableDerivedCharacterAttribute
											{
												Character Attribute=Derived Character Attributes/(HP) Hit Points
											}
											Operator=
											Operand2=CConstant
											{
												Constant Value=498
											}
										}
										Character to get attributes from=$Trigger
										Then=CPrintCombatTextAction
										{
											Text to print=Health at full strength: 497.
											Character to show text to=$Instigator
											Emphasize=0
											Suppress Duplicates=0
										}
										Else=CPrintCombatTextAction
										{
											Text to print=Health at full strength: 498.
											Character to show text to=$Instigator
											Emphasize=0
											Suppress Duplicates=0
										}
									}
									Else=CIfExpressionAction
									{
										If Expression=CIsLessThan
										{
											Operand1=CVariableDerivedCharacterAttribute
											{
												Character Attribute=Derived Character Attributes/(HP) Hit Points
											}
											Operator=
											Operand2=CConstant
											{
												Constant Value=500
											}
										}
										Character to get attributes from=$Trigger
										Then=CPrintCombatTextAction
										{
											Text to print=Health at full strength: 499.
											Character to show text to=$Instigator
											Emphasize=0
											Suppress Duplicates=0
										}
										Else=CPrintCombatTextAction
										{
											Text to print=Health at full strength: 500 or more.
											Character to show text to=$Instigator
											Emphasize=0
											Suppress Duplicates=0
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
	Use=Shared Global Instance
}
