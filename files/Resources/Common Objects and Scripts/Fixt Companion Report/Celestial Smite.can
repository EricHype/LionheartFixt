											{
												Skill=Skills/Magic Divine/Offensive/Celestial Smite
											}
											Operator=
											Operand2=CConstant
											{
												Constant Value=299
											}
										}
										Character to get attributes from=$Trigger
										Then=CPrintCombatTextAction
										{
											Text to print=Celestial Smite: 298.
											Character to show text to=$Instigator
											Emphasize=0
											Suppress Duplicates=0
										}
										Else=CIfExpressionAction
										{
											If Expression=CIsLessThan
											{
												Operand1=CVariableSkill
												{
													Skill=Skills/Magic Divine/Offensive/Celestial Smite
												}
												Operator=
												Operand2=CConstant
												{
													Constant Value=300
												}
											}
											Character to get attributes from=$Trigger
											Then=CPrintCombatTextAction
											{
												Text to print=Celestial Smite: 299.
												Character to show text to=$Instigator
												Emphasize=0
												Suppress Duplicates=0
											}
											Else=CPrintCombatTextAction
											{
												Text to print=Celestial Smite: 300 or more.
												Character to show text to=$Instigator
												Emphasize=0
												Suppress Duplicates=0
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
	Use=Shared Global Instance
}
