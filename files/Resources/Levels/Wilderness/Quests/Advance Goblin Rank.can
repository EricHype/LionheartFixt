									{
										Item Count=1
										Perk To Check For=Perks/!Event Title Perks/Goblin Traitor
									}
								}
								Character to get attributes from=$Instigator
							}
						}
					}
				}
				Action=CExpressionAction
				{
					Expression=CIsGreaterThan
					{
						Operand1=CVariableDerivedCharacterAttribute
						{
							Character Attribute=Derived Character Attributes/Game Scripting Variables/Fixt Goblin Ladder This Game
						}
						Operator=
						Operand2=CConstant
						{
							Constant Value=0
						}
					}
					Character to get attributes from=$Instigator
				}
			}
		}
		Then=CMultipleActionsAction
		{
			Action=Array
			{
				Item Count=2
				Action=CAddCharacterModifierToCharacterAction
				{
					Modifier Description=
					Modification is permanent=1
					Character to modify=$Instigator
					Modifiers=Array
					{
						Item Count=1
						Modifier=CCharacterModifierDerivedAttribute
						{
							Modification Amount=CConstant
							{
								Constant Value=1
							}
							Modification amount is a percent=0
							Allow Accumulation=0
							Derived character attribute to modify=Derived Character Attributes/Game Scripting Variables/Fixt Goblin Ladder This Game
						}
					}
					OPTIONAL Duration=
					Expression Context=$Instigator
				}
				Action=CIfAction
				{
					If=CNotAction
					{
						Action=COrAction
						{
							Action=Array
							{
								Item Count=3
								Action=CExpressionAction
								{
									Expression=CHasPerkExpression
									{
										Perks To Check For=Array
										{
											Item Count=1
											Perk To Check For=Perks/!Event Title Perks/Goblin Chum
										}
									}
									Character to get attributes from=$Instigator
								}
								Action=CExpressionAction
								{
									Expression=CHasPerkExpression
									{
										Perks To Check For=Array
										{
											Item Count=1
											Perk To Check For=Perks/!Event Title Perks/Goblin Blooded
										}
									}
									Character to get attributes from=$Instigator
								}
								Action=CExpressionAction
								{
									Expression=CHasPerkExpression
									{
										Perks To Check For=Array
										{
											Item Count=1
											Perk To Check For=Perks/!Event Title Perks/Goblin Champion
										}
									}
									Character to get attributes from=$Instigator
								}
							}
						}
					}
					Then=CMultipleActionsAction
					{
						Action=Array
						{
							Item Count=2
							Action=CIfAction
							{
								If=CAndAction
								{
									Action=Array
									{
										Item Count=4
										Action=CExpressionAction
										{
											Expression=CUseCannedExpressionExpression
											{
												Canned Expression=Dialog/Requirements/Faction/Templar NOT
											}
											Character to get attributes from=$Instigator
										}
										Action=CExpressionAction
										{
											Expression=CUseCannedExpressionExpression
											{
												Canned Expression=Dialog/Requirements/Faction/Inquisitor NOT
											}
											Character to get attributes from=$Instigator
										}
										Action=CExpressionAction
										{
											Expression=CUseCannedExpressionExpression
											{
												Canned Expression=Dialog/Requirements/Faction/Saladin NOT
											}
											Character to get attributes from=$Instigator
										}
										Action=CExpressionAction
										{
											Expression=CUseCannedExpressionExpression
											{
												Canned Expression=Dialog/Requirements/Faction/Wielder NOT
											}
											Character to get attributes from=$Instigator
										}
									}
									Early Exit=0
								}
								Then=CAssignFactionToCharacterAction
								{
									Faction To Assign=Factions/Goblin Chum
									Character To assign=$Instigator
								}
								Else=
								Return failure if the If failes=0
							}
							Action=CGiveCharacterPerkAction
							{
								Character to give perk to=$Instigator
								Perk to give=Perks/!Event Title Perks/Goblin Chum
							}
						}
					}
					Else=CIfAction
					{
						If=CNotAction
						{
							Action=COrAction
							{
								Action=Array
								{
									Item Count=2
									Action=CExpressionAction
									{
										Expression=CHasPerkExpression
										{
											Perks To Check For=Array
											{
												Item Count=1
												Perk To Check For=Perks/!Event Title Perks/Goblin Blooded
											}
										}
										Character to get attributes from=$Instigator
									}
									Action=CExpressionAction
									{
										Expression=CHasPerkExpression
										{
											Perks To Check For=Array
											{
												Item Count=1
												Perk To Check For=Perks/!Event Title Perks/Goblin Champion
											}
										}
										Character to get attributes from=$Instigator
									}
								}
							}
						}
						Then=CMultipleActionsAction
						{
							Action=Array
							{
								Item Count=2
								Action=CIfAction
								{
									If=CAndAction
									{
										Action=Array
										{
											Item Count=4
											Action=CExpressionAction
											{
												Expression=CUseCannedExpressionExpression
												{
													Canned Expression=Dialog/Requirements/Faction/Templar NOT
												}
												Character to get attributes from=$Instigator
											}
											Action=CExpressionAction
											{
												Expression=CUseCannedExpressionExpression
												{
													Canned Expression=Dialog/Requirements/Faction/Inquisitor NOT
												}
												Character to get attributes from=$Instigator
											}
											Action=CExpressionAction
											{
												Expression=CUseCannedExpressionExpression
												{
													Canned Expression=Dialog/Requirements/Faction/Saladin NOT
												}
												Character to get attributes from=$Instigator
											}
											Action=CExpressionAction
											{
												Expression=CUseCannedExpressionExpression
												{
													Canned Expression=Dialog/Requirements/Faction/Wielder NOT
												}
												Character to get attributes from=$Instigator
											}
										}
										Early Exit=0
									}
									Then=CAssignFactionToCharacterAction
									{
										Faction To Assign=Factions/Goblin Blooded
										Character To assign=$Instigator
									}
									Else=
									Return failure if the If failes=0
								}
								Action=CGiveCharacterPerkAction
								{
									Character to give perk to=$Instigator
									Perk to give=Perks/!Event Title Perks/Goblin Blooded
								}
							}
						}
						Else=CIfAction
						{
							If=CNotAction
							{
								Action=COrAction
								{
									Action=Array
									{
										Item Count=1
										Action=CExpressionAction
										{
											Expression=CHasPerkExpression
											{
												Perks To Check For=Array
												{
													Item Count=1
													Perk To Check For=Perks/!Event Title Perks/Goblin Champion
												}
											}
											Character to get attributes from=$Instigator
										}
									}
								}
							}
							Then=CMultipleActionsAction
							{
								Action=Array
								{
									Item Count=2
									Action=CIfAction
									{
										If=CAndAction
										{
											Action=Array
											{
												Item Count=4
												Action=CExpressionAction
												{
													Expression=CUseCannedExpressionExpression
													{
														Canned Expression=Dialog/Requirements/Faction/Templar NOT
													}
													Character to get attributes from=$Instigator
												}
												Action=CExpressionAction
												{
													Expression=CUseCannedExpressionExpression
													{
														Canned Expression=Dialog/Requirements/Faction/Inquisitor NOT
													}
													Character to get attributes from=$Instigator
												}
												Action=CExpressionAction
												{
													Expression=CUseCannedExpressionExpression
													{
														Canned Expression=Dialog/Requirements/Faction/Saladin NOT
													}
													Character to get attributes from=$Instigator
												}
												Action=CExpressionAction
												{
													Expression=CUseCannedExpressionExpression
													{
														Canned Expression=Dialog/Requirements/Faction/Wielder NOT
													}
													Character to get attributes from=$Instigator
												}
											}
											Early Exit=0
										}
										Then=CAssignFactionToCharacterAction
										{
											Faction To Assign=Factions/Goblin Champion
											Character To assign=$Instigator
										}
										Else=
										Return failure if the If failes=0
									}
									Action=CGiveCharacterPerkAction
									{
										Character to give perk to=$Instigator
										Perk to give=Perks/!Event Title Perks/Goblin Champion
									}
								}
							}
							Else=
							Return failure if the If failes=0
						}
						Return failure if the If failes=0
					}
					Return failure if the If failes=0
				}
			}
		}
		Else=
		Return failure if the If failes=0
	}
	Use=Shared Global Instance
}
