CCannedObject
{
	Object=CIfAction
	{
		If=COrAction
		{
			Action=Array
			{
				Item Count=2
				Action=CNotAction
				{
					Action=COrAction
					{
						Action=Array
						{
							Item Count=4
							Action=CExpressionAction
							{
								Expression=CHasPerkExpression
								{
									Perks To Check For=Array
									{
										Item Count=1
										Perk To Check For=Perks/!Event Title Perks/Goblin Chum
									}
								}
								Character to get attributes from=$Instigator
							}
							Action=CExpressionAction
							{
								Expression=CHasPerkExpression
								{
									Perks To Check For=Array
									{
										Item Count=1
										Perk To Check For=Perks/!Event Title Perks/Goblin Blooded
									}
								}
								Character to get attributes from=$Instigator
							}
							Action=CExpressionAction
							{
								Expression=CHasPerkExpression
								{
									Perks To Check For=Array
									{
										Item Count=1
										Perk To Check For=Perks/!Event Title Perks/Goblin Champion
									}
								}
								Character to get attributes from=$Instigator
							}
							Action=CExpressionAction
							{
								Expression=CHasPerkExpression
								{
