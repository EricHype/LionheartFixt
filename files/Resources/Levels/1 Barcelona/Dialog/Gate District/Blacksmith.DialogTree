CDialogTree
{
Name=Eduardo the Blacksmith
Portrait=Dialog/NPC Portraits/BlackSmith
Should Have Voiceovers=1
Default Canceled Node Action=
------------------------------------------------------------
Node ID=01 Introduction Non-tainted Male
Text=Buenos dias, senor! Adelante, adelante <Come in, come in> - welcome to Eduardo's Blacksmith Shop. Come to purchase the finest weapons in Barcelona, no? Simple iron to enchanted steel, you will find it all here!
Should Have Voiceover=1

Requirement=!None
Custom Requirement=CAND
{
Operand1=COR
{
Operand1=CUseCannedExpressionExpression
{
Canned Expression=Dialog/Requirements/Faction/Wielder IS
}
Operator=
Operand2=CUseCannedExpressionExpression
{
Canned Expression=Dialog/Requirements/Faction/Inquisitor IS
}
}
Operator=
Operand2=CActionExpression
{
Action=CActionCheckForInventoryItem
{
Who to give check=$instigator
Inventory Item To Check For=Inventory/Specific Item Cans/Quest Items/Felgnash Sword
}
}
}
Reply Text=I have a blade that I believe belongs to you.
Go to node ID=
Custom Action=CMultipleActionsAction
{
Action=Array
{
Item Count=4
Action=CActionRemoveInventoryItem
{
Who to remove from=$instigator
Inventory Item To remove=Inventory/Specific Item Cans/Quest Items/Felgnash Sword
}
Action=CGiveExperiencePointsToAllPlayersAction
{
Get XP Frome=Recover Father's sword 
Experience Points To Add=1
}
Action=CGiveMoneyToAllPlayersAction
{
Value to give=200
}
Action=CTriggerRelayAction
{
Relay Name=recover sword but not for templar quest
}
}
}

Requirement=Blacksmith Need LionShield
Reply Text=I've been told you can forge a Lion Shield.
