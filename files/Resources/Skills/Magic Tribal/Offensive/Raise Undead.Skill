CSkillDescription
{
	PlugIn Behaviors=Array
	{
		Item Count=5
		PlugIn Behavior=CPlugInBehaviorSpell
		{
			ManaUse=CMultiply
			{
				Operand1=CVariableDerivedCharacterAttribute
				{
					Character Attribute=Derived Character Attributes/Perk and Trait Support/Tribal Spell Cast Multiplier
				}
				Operator=
				Operand2=CConstant
				{
					Constant Value=40
				}
			}
			Duration=CConstant
			{
				Constant Value=180
			}
			Automatically disable recasting of spell for duration=1
			Maximum Range=CConstant
			{
				Constant Value=700
			}
		}
		PlugIn Behavior=CPlugInBehaviorPlaySequence
		{
			Granny Animations=Array
			{
				Item Count=0
			}
			Sequence Name=SpellCast
			Random Sequence Selection=0
			Sequence Index=-1
		}
		PlugIn Behavior=CPlugInBehaviorAttack
		{
			Max Attack Range=800
			Is Location Based=1
			Can Use Slayer Mode=0
			Can Use Sniper Mode=0
			Action On Hit=
			Action On Miss=
		}
		PlugIn Behavior=CXRPGPlugInBehaviorLauncher
		{
			After Launch Action=
			Num To Launch=1
			Dispersion Angle=180
			Aim At Parents Target=1
			Launch Offset=0.000000,0.000000
			Parents Bone Launch Location=Bip01 R Hand
			Direction From Bone X=0
			Direction From Bone Y=0
			Direction From Bone Z=0
			Requires Line Of Sight=1
			Primary Launchable Slot=Character Slot Types/!None
			Secondary Launchable Types=Array
			{
				Item Count=1
				Secondary Launchable Type=Spell Projectiles/Raise Undead Instant Hit Projectile
			}
			Damages=Array
			{
				Item Count=0
			}
		}
		PlugIn Behavior=CPlugInBehaviorLaunchAction
		{
			Launch Action=CMultipleActionsAction
			{
				Action=Array
				{
					Item Count=5
					Action=CAddCharacterModifierToCharacterAction
					{
						Modifier Description=
						Modification is permanent=0
						Character to modify=$Instigator
						Modifiers=Array
						{
							Item Count=1
							Modifier=CCharacterModifierDerivedAttribute
							{
								Modification Amount=CIfExpression
								{
									Condition=CIsEqualTo
									{
										Operand1=CVariableDerivedCharacterAttribute
										{
											Character Attribute=Derived Character Attributes/Game Scripting Variables/Player has cast a spell
										}
										Operator=
										Operand2=CConstant
										{
											Constant Value=0
										}
									}
									OperatorPart1=
									Value if True =CConstant
									{
										Constant Value=1
									}
									OperatorPart2=
									Value if False=CConstant
									{
										Constant Value=0
									}
								}
								Modification amount is a percent=0
								Allow Accumulation=0
								Derived character attribute to modify=Derived Character Attributes/Game Scripting Variables/Player has cast a spell
							}
						}
						OPTIONAL Duration=CConstant
						{
							Constant Value=0.1
						}
						Expression Context=$Instigator
					}
					Action=CIfAction
					{
						If=CCheckCategoryAction
						{
							Target Name=$Instigator
							Category to check for=Player
						}
						Then=CTriggerRelayAction
						{
							Relay Name=Spellcast
						}
						Else=
						Return failure if the If failes=0
					}
					Action=CDisableRecastingOfSpellForSpellsDuration
					{
						Spell=Skills/Magic Tribal/Offensive/Raise Enemy
						Character To Disable=$Caster
						OPTIONAL Duration=CVariableSpellDuration
						{
							Spell=Skills/Magic Tribal/Offensive/Raise Undead
						}
					}
					Action=CDisableRecastingOfSpellForSpellsDuration
					{
						Spell=Skills/Magic Tribal/Offensive/Monster Summoning
						Character To Disable=$Caster
						OPTIONAL Duration=CVariableSpellDuration
						{
							Spell=Skills/Magic Tribal/Offensive/Raise Undead
						}
					}
					Action=CDisableRecastingOfSpellForSpellsDuration
					{
						Spell=Skills/Magic Divine/Offensive/Spiritual Knight
						Character To Disable=$Caster
						OPTIONAL Duration=CVariableSpellDuration
						{
							Spell=Skills/Magic Tribal/Offensive/Raise Undead
						}
					}
				}
			}
		}
	}
	Display Name=Raise Undead
	Description=%?[zombie]Summons a Zombie with %i[ShowZombieHPPercent]% of it's normal Hit Points and %i[ShowZombieDamagePercent]% of it's normal damage to fight for the caster.%?[HideZombieBonus]%?[ShowNoPerkBonus] At higher levels, the Zombie gains a damage bonus. At still higher levels, other types of undead are summoned.%?[ShowNoPerkBonus]%?[ShowNecrosageBonus] The Zombie also gains a +%i[ZombiePerkBonus] damage bonus (includes the Necrosage Perk bonus). At higher levels, other types of undead are summoned.%?[ShowNecrosageBonus]%?[HideZombieBonus]%?[ShowZombieBonus] The Zombie also gains a +%i[ZombiePerkBonus] damage bonus%?[ShowNecrosageBonus] (includes the Necrosage Perk bonus)%?[ShowNecrosageBonus]. At higher levels, other types of undead are summoned.%?[ShowZombieBonus]%?[zombie]%?[skeleton]Summons a Greater Skeleton with %i[ShowSkeletonHPPercent]% of it's normal Hit Points%?[PerkHPBonus] (including the Undead Glory Perk bonus)%?[PerkHPBonus] and %i[ShowSkeletonDamagePercent]% of it's normal damage to fight for the caster.%?[HideSkeletonBonus]%?[ShowNoPerkBonus] At higher levels, the Skeleton gains a damage bonus. At still higher levels, a Soul Reaver will be summoned.%?[ShowNoPerkBonus]%?[ShowNecrosageBonus] The Skeleton also gains a +%i[SkeletonPerkBonus] damage bonus (includes the Necrosage Perk bonus). At higher levels, a Soul Reaver will be summoned.%?[ShowNecrosageBonus]%?[ShowUndeadGloryBonus] The Skeleton also gains a +%i[SkeletonPerkBonus] damage bonus (includes the Undead Glory Perk bonus). At higher levels, a Soul Reaver will be summoned.%?[ShowUndeadGloryBonus]%?[ShowBothPerkBonus] The Skeleton also gains a +%i[SkeletonPerkBonus] damage bonus (includes the Necrosage and Undead Glory Perk bonuses). At higher levels, a Soul Reaver will be summoned.%?[ShowBothPerkBonus]%?[HideSkeletonBonus]%?[ShowSkeletonBonus] The Skeleton also gains a +%i[SkeletonPerkBonus] damage bonus%?[ShowNecrosageBonus] (includes the Necrosage Perk bonus)%?[ShowNecrosageBonus]%?[ShowUndeadGloryBonus] (includes the Undead Glory Perk bonus)%?[ShowUndeadGloryBonus]%?[ShowBothPerkBonus] (includes the Necrosage and Undead Glory Perk bonuses)%?[ShowBothPerkBonus]. At higher levels, a Soul Reaver will be summoned.%?[ShowSkeletonBonus]%?[skeleton]%?[soulreaver]Summons a Soul Reaver with %i[ShowSoulReaverHPPercent]% of it's normal Hit Points%?[PerkHPBonus] (including the Undead Glory Perk bonus)%?[PerkHPBonus] and %i[ShowSoulReaverDamagePercent]% of it's normal damage to fight for the caster.%?[HideSoulReaverBonus]%?[ShowNoPerkBonus] At higher levels, the Soul Reaver gains a damage bonus.%?[ShowNoPerkBonus]%?[ShowNecrosageBonus] The Soul Reaver also gains a +%i[SoulReaverPerkBonus] damage bonus (includes the Necrosage Perk bonus).%?[ShowNecrosageBonus]%?[ShowUndeadGloryBonus] The Soul Reaver also gains a +%i[SoulReaverPerkBonus] damage bonus (includes the Undead Glory Perk bonus).%?[ShowUndeadGloryBonus]%?[ShowBothPerkBonus] The Soul Reaver also gains a +%i[SoulReaverPerkBonus] damage bonus (includes the Necrosage and Undead Glory Perk bonuses).%?[ShowBothPerkBonus]%?[HideSoulReaverBonus]%?[ShowSoulReaverBonus] The Soul Reaver also gains a +%i[SoulReaverPerkBonus] damage bonus%?[ShowNecrosageBonus] (includes the Necrosage Perk bonus)%?[ShowNecrosageBonus]%?[ShowUndeadGloryBonus] (includes the Undead Glory Perk bonus)%?[ShowUndeadGloryBonus]%?[ShowBothPerkBonus] (includes the Necrosage and Undead Glory Perk bonuses)%?[ShowBothPerkBonus].%?[ShowSoulReaverBonus]%?[soulreaver] Maintaining a summoned undead warrior slowly drains the caster's mana. You may not maintain two summoning spells simultaneously. One who holds the Necromancer title raises the dead as though this spell were at their full Summoning skill, and keeps one of each kind it can command: a Zombie, a Greater Skeleton from 50, and a Soul Reaver from 100. Each cast raises the strongest one missing.
