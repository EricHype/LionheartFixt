								Delete AI When Done=0
								Remove Wait AI If Actor Dies=1
							}
							Original AI Type=CSkeletonAI
							Completion Message to wait for=AI Done
							Suppress can't assign error=0
						}
						Action=CAddCharacterModifierToCharacterAction
						{
							Modifier Description=
							Modification is permanent=0
							Character to modify=$trigger
							Modifiers=Array
							{
								Item Count=1
								Modifier=CCharacterModifierDerivedAttribute
								{
									Modification Amount=CSkillsNamedExpressionExpression
									{
										Skill=Skills/Fake Wand Spells/Rigor Mortis
