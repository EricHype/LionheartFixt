									}
									Modification amount is a percent=1
									Allow Accumulation=0
									Derived character attribute to modify=Derived Character Attributes/Speed/Base Animation Speed Multiplier
								}
							}
							OPTIONAL Duration=CSkillsNamedExpressionExpression
							{
								Skill=Skills/Fake Wand Spells/Rigor Mortis
								Expression Name=duration
							}
							Expression Context=$Instigator
						}
						Action=CActionRemoveInventoryItem
						{
							Who to remove from=$Instigator
							Inventory Item To remove=Inventory Items/Wand Charge
						}
					}
				}
				Else=CPrintCombatTextAction
				{
					Text to print=The wand has no charges left
					Character to show text to=$Instigator
					Emphasize=0
					Suppress Duplicates=1
				}
				Return failure if the If failes=0
			}
		}
